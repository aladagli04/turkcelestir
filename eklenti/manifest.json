{
  "manifest_version": 3,
  "name": "Türkçeleştir",
  "version": "0.3.0",
  "description": "Türkçe karakterleri (ç ğ ı ö ş ü) sağ tıkla düzeltir; isterseniz büyük harf ve noktalamayı da.",
  "homepage_url": "https://github.com/aladagli04/turkcelestir",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "options_page": "ayarlar.html",
  "action": {
    "default_title": "Türkçeleştir",
    "default_popup": "pencere.html",
    "default_icon": {
      "16": "ikon/16.png",
      "32": "ikon/32.png"
    }
  },
  "icons": {
    "16": "ikon/16.png",
    "32": "ikon/32.png",
    "48": "ikon/48.png",
    "128": "ikon/128.png"
  },
  "commands": {
    "karakter": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Sadece Türkçe karakterler"
    },
    "tam": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "Karakter + büyük harf + noktalama"
    },
    "yz": {
      "suggested_key": {
        "default": "Alt+U"
      },
      "description": "Yapay zekâ ile tam düzelt (Chrome yerleşik)"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
